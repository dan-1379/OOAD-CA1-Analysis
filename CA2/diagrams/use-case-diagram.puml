@startuml
    left to right direction
    skinparam usecase {
        BackgroundColor<<deferred>> #EEEEEE
        BorderColor<<deferred>> #999999
        FontColor<<deferred>> #777777
        BorderStyle<<deferred>> dashed
    }

    actor Student
    actor "Placement Staff" as Staff
    actor Employer
    actor Administrator
    actor "Placement Coordinator" as Coordinator

    rectangle "Student Work-Placement Coordination Service" {
        usecase "Submit Placement Request" as UC01
        usecase "View Request Status" as UC02
        usecase "View Placement Record" as UC03
        usecase "Apply Priority Rules" as UC04 <<deferred>>
        usecase "Verify Third-Party Permission" as UC05
        usecase "Record Selection Decision" as UC06
        usecase "Record Academic Approval" as UC07
        usecase "Release Stalled Provisional Placement" as UC08
        usecase "View Provisional Opportunities" as UC09
        usecase "Set Action Status" as UC10
        usecase "Evaluate Change Dependencies" as UC11
        usecase "Record Off-Site Progress Updates" as UC12
    }

    Student -- UC01
    Student -- UC02

    Staff -- UC03
    Staff -- UC04
    Staff -- UC05
    Staff -- UC07
    Staff -- UC10
    Staff -- UC12

    Employer -- UC06

    Administrator -- UC08

    Coordinator -- UC09
    Coordinator -- UC11

    note bottom of UC04
        Deferred until priority rules
        are agreed (Q2, RC03)
    end note
@enduml